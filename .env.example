PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/nutrition_app
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# For development: skip email verification (links are also printed in the server console)
AUTO_VERIFY_EMAIL=true

# Optional: real email (Gmail SMTP needs an "app password")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nutrition App <no-reply@example.com>

# Used by `npm run seed` to create the first admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NICKNAME=admin
