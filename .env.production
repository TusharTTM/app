# API base URL baked into production / APK builds.
# Replace this with your own API, then rebuild the APK (see BUILD-ANDROID.md).
#
#   Android emulator talking to a server on your PC : http://10.0.2.2:5000/api
#   Physical phone on the same Wi-Fi as your PC      : http://<your-PC-LAN-IP>:5000/api
#   Deployed server                                  : https://your-api-domain.com/api
#
# In a Capacitor APK there is no dev proxy, so this must point at a reachable
# server. The value below is a placeholder that works only on the Android
# emulator when you run the Express server on the same PC.
VITE_API_URL=http://10.0.2.2:5000/api
